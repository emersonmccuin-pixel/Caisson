# QA agent scratch surface — transient files, never committed.
# Agents write ephemeral specs here; curated specs live at e2e/*.spec.py.
qa-scratch/*.spec.py
qa-scratch/*.spec.ts
qa-scratch/*.spec.js
# Agent work products not tracked
qa-scratch/*.json
qa-scratch/*.log

# Screenshot / video evidence — large binaries; store externally or attach
# via pc_attach_to_work_item.
evidence/*.png
evidence/*.jpg
evidence/*.webm
evidence/*.mp4
